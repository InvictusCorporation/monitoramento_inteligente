# Copie para .env; inicie com: node --env-file=.env server/start.mjs
PORT=8087
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:8087
NODE_ENV=development
# Caminho absoluto de um FFmpeg instalado de fonte confiável, com libx264.
FFMPEG_PATH=
# Lista JSON. Um endereço é liberado somente para o clientId indicado.
# Exemplo de formato (substitua pelos dados reais):
# CAMERA_ALLOWED_ENDPOINTS='[{"clientId":"id-do-local","address":"192.168.1.100:554"}]'
CAMERA_ALLOWED_ENDPOINTS=[]
# Opcionais. Sem valores, são usados data/monitoramento.sqlite e data/camera.key.
DB_PATH=
CAMERA_KEY_PATH=
